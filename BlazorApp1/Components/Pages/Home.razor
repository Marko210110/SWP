@page "/"

<div class="home-container">
    <div class="hero-section">
        <h1>FITNESS HUB</h1>
        <p class="subtitle">Your Ultimate Exercise Database</p>
        <div class="hero-stats">
            <div class="stat-box">
                <span class="stat-number">1300+</span>
                <span class="stat-label">Exercises</span>
            </div>
            <div class="stat-box">
                <span class="stat-number">10</span>
                <span class="stat-label">Body Parts</span>
            </div>
            <div class="stat-box">
                <span class="stat-number">20+</span>
                <span class="stat-label">Equipment Types</span>
            </div>
            <div class="stat-box">
                <span class="stat-number">30+</span>
                <span class="stat-label">Target Muscles</span>
            </div>
        </div>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <h3>Search Exercises</h3>
            <p>Find exercises by name. View detailed instructions, target muscles, and animated GIFs.</p>
            <a href="exercises" class="btn-primary">Search Now</a>
        </div>
        <div class="feature-card">
            <h3>By Body Part</h3>
            <p>Browse exercises filtered by body part - chest, back, legs, arms, abs and more.</p>
            <a href="bodyparts" class="btn-primary">Browse</a>
        </div>
        <div class="feature-card">
            <h3>By Target Muscle</h3>
            <p>Focus on specific muscles with targeted exercise collections.</p>
            <a href="targets" class="btn-primary">Explore</a>
        </div>
        <div class="feature-card">
            <h3>By Equipment</h3>
            <p>Find exercises based on available equipment - from bodyweight to gym machines.</p>
            <a href="equipment" class="btn-primary">Filter</a>
        </div>
    </div>

    <div class="featured-section">
        <h2>Popular Body Parts</h2>
        <div class="body-parts-preview">
            <div class="part-preview">
                <h4>Chest</h4>
                <p>Build upper body strength</p>
            </div>
            <div class="part-preview">
                <h4>Back</h4>
                <p>Develop a strong back</p>
            </div>
            <div class="part-preview">
                <h4>Legs</h4>
                <p>Powerful lower body</p>
            </div>
            <div class="part-preview">
                <h4>Abs</h4>
                <p>Core strength & definition</p>
            </div>
            <div class="part-preview">
                <h4>Arms</h4>
                <p>Biceps & triceps</p>
            </div>
            <div class="part-preview">
                <h4>Shoulders</h4>
                <p>Build deltoid muscles</p>
            </div>
        </div>
    </div>
</div>
