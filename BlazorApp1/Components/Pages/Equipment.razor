@page "/equipment"
@rendermode InteractiveServer
@inject ExerciseService ExerciseService

<h3>Exercises by Equipment</h3>

@if (equipmentList.Count > 0)
{
    <div class="category-tabs">
        @foreach (var eq in equipmentList)
        {
            <button class="tab-btn @(selectedEquipment == eq ? "active" : "")" @onclick="() => SelectEquipment(eq)">
                @eq
            </button>
        }
    </div>
}

@if (isLoading)
{
    <div class="loading">Loading exercises...</div>
}

@if (exercises.Count > 0)
{
    <div class="exercise-grid">
        @foreach (var exercise in exercises)
        {
            <div class="exercise-card" @onclick="() => SelectExercise(exercise)">
                @if (!string.IsNullOrEmpty(exercise.GifUrl))
                {
                    <img src="@exercise.GifUrl" alt="@exercise.Name" loading="lazy" />
                }
                else
                {
                    <div class="exercise-placeholder">💪</div>
                }
                <h4>@exercise.Name</h4>
                <div class="tags">
                    <span class="tag body-part">@exercise.BodyPart</span>
                    <span class="tag target">@exercise.Target</span>
                </div>
            </div>
        }
    </div>
}

@if (selectedExercise != null)
{
    <div class="exercise-modal" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <button class="close-btn" @onclick="CloseModal">X</button>
            <h2>@selectedExercise.Name</h2>
            
            @if (!string.IsNullOrEmpty(selectedExercise.GifUrl))
            {
                <img src="@selectedExercise.GifUrl" alt="@selectedExercise.Name" class="exercise-gif" />
            }
            
            <div class="tags" style="justify-content: center; margin: 16px 0;">
                <span class="tag body-part">@selectedExercise.BodyPart</span>
                <span class="tag target">@selectedExercise.Target</span>
                <span class="tag equipment">@selectedExercise.Equipment</span>
            </div>

            @if (selectedExercise.SecondaryMuscles != null && selectedExercise.SecondaryMuscles.Count > 0)
            {
                <div class="secondary-muscles">
                    <strong>Secondary Muscles:</strong> @string.Join(", ", selectedExercise.SecondaryMuscles)
                </div>
            }

            @if (selectedExercise.Instructions != null && selectedExercise.Instructions.Count > 0)
            {
                <div class="instructions">
                    <h4>Instructions</h4>
                    <ol>
                        @foreach (var instruction in selectedExercise.Instructions)
                        {
                            <li>@instruction</li>
                        }
                    </ol>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<string> equipmentList = new();
    private List<Exercise> exercises = new();
    private Exercise? selectedExercise;
    private string selectedEquipment = "";
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        equipmentList = await ExerciseService.GetEquipmentListAsync();
        if (equipmentList.Count > 0)
        {
            await SelectEquipment(equipmentList[0]);
        }
    }

    async Task SelectEquipment(string eq)
    {
        selectedEquipment = eq;
        isLoading = true;
        exercises = await ExerciseService.GetExercisesByEquipmentAsync(eq);
        isLoading = false;
    }

    async Task SelectExercise(Exercise exercise)
    {
        selectedExercise = await ExerciseService.GetExerciseByIdAsync(exercise.Id ?? "");
        if (selectedExercise == null)
        {
            selectedExercise = exercise;
        }
    }

    void CloseModal()
    {
        selectedExercise = null;
    }
}
